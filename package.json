{
  "name": "gwtar",
  "version": "0.6.0",
  "description": "Package static HTML builds as range-loadable Gwtar archives",
  "type": "module",
  "bin": {
    "gwtar": "./bin/gwtar.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./vite": {
      "import": "./adapters/vite.js"
    },
    "./webpack": {
      "import": "./adapters/webpack.js"
    },
    "./bun": {
      "import": "./adapters/bun.js"
    }
  },
  "files": [
    "index.js",
    "adapters",
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:bun": "bun test test/bun.test.js",
    "test:install": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "entities": "9.0.0",
    "mime": "^4.1.2",
    "prettier": "3.10.1",
    "unplugin": "3.7.0"
  },
  "devDependencies": {
    "bun": "^1.4.5",
    "playwright": "^1.65.1",
    "vite": "^8.3.8",
    "webpack": "^5.113.0"
  }
}
